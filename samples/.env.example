# Settings for samples/docker-compose.yml. Copy to .env.
#
#   cp samples/.env.example samples/.env
#
# Compose reads samples/.env automatically. Leave a value out and the default in
# docker-compose.yml applies — except the last two, which have none.

# ---------------------------------------------------------------------------
# Where your deployment is. Verbatim, scheme and port included — deploy/.env
# must set IDEN_ISSUER to exactly the same string, because the issuer is
# compared character for character.
#
#   Public deployment      https://iden.example.org
#   On this machine        http://iden.localtest.me:8000
#
# Not `http://localhost:8000` in the second case: this one string is resolved by
# your browser AND by the sample containers, and inside a container `localhost`
# is the container. `iden.localtest.me` is a public name that resolves to
# 127.0.0.1, so your browser reaches your published port, and the line below
# gets the containers there too.
# ---------------------------------------------------------------------------
IDEN_ISSUER=http://iden.localtest.me:8000

# The host in IDEN_ISSUER, when IDEN runs on this machine — the containers then
# resolve it to your machine instead of to themselves.
#
# For a deployment with real public DNS, leave this exactly as it is. It names
# something nothing looks up, and is ignored. Putting the real hostname here
# would point these containers at your own machine and they would never reach
# the deployment at all.
IDEN_LOCAL_HOST=iden.localtest.me

# ---------------------------------------------------------------------------
# The clients you registered. Each sample's README names the redirect URI and
# scopes it expects; the seed does not create them, because a sample client
# with a live redirect URI is not something to leave lying around by accident.
#
# Register these against the *browser* origins — localhost:5200 and the rest —
# not the issuer name above. That is where your browser comes back to.
# ---------------------------------------------------------------------------
PORTAL_CLIENT_ID=demo-portal
LIBRARY_CLIENT_ID=demo-library
NEXTJS_CLIENT_ID=demo-nextjs

# The Next.js sample is the only confidential client here: Auth.js exchanges the
# code from its own server, so it has a secret. Shown once, at registration.
NEXTJS_CLIENT_SECRET=

# Signs Auth.js's own session cookie, and nothing to do with IDEN.
#   openssl rand -base64 32
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Where the browser reaches each sample.
#
# Only needed behind docker-compose.tunnel.yml, where these become the public
# hostnames you mapped. Each one is what its client's redirect URI must be
# registered against, and a redirect URI is matched exactly.
# ---------------------------------------------------------------------------
# PORTAL_ORIGIN=https://portal.example.org
# LIBRARY_ORIGIN=https://library.example.org
# AUTH_URL=https://nextjs.example.org

# The deployment's Docker network, which cloudflared reaches the samples over.
# The compose project name with `_default` appended.
# IDEN_NETWORK=iden-dev_default

# Auth.js needs to know its own origin to build the redirect URI.
AUTH_URL=
