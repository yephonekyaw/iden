# Copy to .env and fill in. The controller needs two settings and holds no
# credential of its own — that is what being a resource server means.

# Must match your deployment's own IDEN_ISSUER character for character.
IDEN_ISSUER=http://localhost:8000

# The audience registered on the `door` resource API in IDEN. Every token this
# service accepts must name it, and a token naming anything else is refused
# even though IDEN signed it.
DOOR_AUDIENCE=https://api.example.org/door
