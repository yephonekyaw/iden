# Copy to .env.local and fill in. `pnpm dev` reads it; the container does not —
# compose passes these as environment variables instead.

# Your deployment, verbatim. Must match its own IDEN_ISSUER character for
# character: the issuer is compared as a string, not parsed as a URL.
IDEN_ISSUER=http://localhost:8000

# The client you registered for this panel. See the README.
DOOR_PANEL_CLIENT_ID=demo-door-panel
DOOR_PANEL_CLIENT_SECRET=

# Where the browser reaches this panel. The redirect URI is built from it, and
# redirect URIs are matched exactly.
DOOR_PANEL_ORIGIN=http://localhost:5401

# Where this server reaches the door controller. Not a browser URL — the
# browser never talks to it.
DOOR_API_ORIGIN=http://localhost:5400
