# Copy to .env.local and fill in.

# Where your IDEN deployment lives. Auth.js reads every endpoint from
# $IDEN_ISSUER/.well-known/openid-configuration — nothing else is configured.
IDEN_ISSUER=http://localhost:8000

# The client you registered. Auth.js exchanges the code on the server, so this
# is a confidential client and the secret never reaches the browser.
IDEN_CLIENT_ID=demo-nextjs
IDEN_CLIENT_SECRET=

# Signs Auth.js's own session cookie. Nothing to do with IDEN.
# openssl rand -base64 32
AUTH_SECRET=

# Auth.js needs to know its own origin to build the redirect URI.
AUTH_URL=http://localhost:5300
