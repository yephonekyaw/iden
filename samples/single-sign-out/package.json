{
  "name": "iden-single-sign-out",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Two applications, one IDEN session. Sign out of either and both end.",
  "scripts": {
    "portal": "APP=portal tsx src/server.ts",
    "library": "APP=library tsx src/server.ts",
    "dev": "concurrently -n portal,library -c magenta,cyan \"pnpm portal\" \"pnpm library\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^22.18.9",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
