# The contents, not the directory: git never descends into an ignored
# directory, so a negation for a file inside one can never take effect.
.vscode/*
# Shared editor settings, which teach the YAML extension that MkDocs'
# `!!python/name:` tags are legitimate. Without it every clone reports
# mkdocs.yml as broken.
!.vscode/settings.json
claude/
.claude/
old-provider/
verification/
# Local biometric test fixtures — real face photos, never committed.
/Face/
# Task-splitting briefs for this repo's own contributors — not project docs.
/claude_code_prompt/
web/**/node_modules/
web/**/dist/

*.log
*.sql
*.sqlite

