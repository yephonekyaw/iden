export ENGINE_ENV=dev
export ENGINE_LOG_LEVEL=info

# Face detection + recognition
export ENGINE_MODEL_PACK=buffalo_l
export ENGINE_MODEL_ROOT=models
export ENGINE_DET_SIZE=640
export ENGINE_MIN_DETECTION_SCORE=0.5
# CPU works everywhere with no setup. On a machine with an NVIDIA GPU and
# `onnxruntime-gpu` installed instead of `onnxruntime`, use:
#   export ENGINE_PROVIDERS=["CUDAExecutionProvider","CPUExecutionProvider"]
export ENGINE_PROVIDERS=["CPUExecutionProvider"]

# Liveness / anti-spoofing — off until a real model is configured, see
# engine/README.md. Every check passes while this is false.
export ENGINE_LIVENESS_ENABLED=false
export ENGINE_LIVENESS_MODEL_PATH=
export ENGINE_LIVENESS_THRESHOLD=0.5
