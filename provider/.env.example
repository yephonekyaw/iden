# Application
export IDEN_ENV=dev
export IDEN_LOG_LEVEL=info
# Leave empty. OIDC requires /.well-known/* at the host root; each router
# declares its own prefix. Only set this to mount IDEN under a sub-path.
export IDEN_API_PREFIX=
export IDEN_ALLOWED_ADMIN_ORIGINS=["http://localhost:5173"]

# Issuer — must match exactly what clients use, or issuer validation fails
export IDEN_ISSUER=http://localhost:8000
export IDEN_AUTH_UI_BASE_URL=http://localhost:4000

# Storage
export IDEN_DATABASE_URL=postgresql+asyncpg://iden:iden@localhost:5432/iden
export IDEN_REDIS_URL=redis://localhost:6379/0

# Crypto — each PEM file's stem in this directory becomes its kid
export IDEN_SIGNING_KEY_DIR=keys
export IDEN_SIGNING_ALGORITHM=RS256

# Lifetimes (seconds)
export IDEN_ACCESS_TOKEN_TTL=600
export IDEN_ID_TOKEN_TTL=600
export IDEN_REFRESH_TOKEN_TTL=2592000
export IDEN_AUTH_CODE_TTL=60
export IDEN_SESSION_TTL=86400
export IDEN_CHALLENGE_TTL=600

# Bootstrap — password is generated and printed once when left empty
export IDEN_BOOTSTRAP_ADMIN_EMAIL=admin@localhost
export IDEN_BOOTSTRAP_ADMIN_PASSWORD=

# Biometric extension
export IDEN_BIOMETRIC_ENABLED=false
export IDEN_ENGINE_BASE_URL=http://engine:8000
