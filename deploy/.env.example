# Deployment-specific settings for deploy/docker-compose.yml. Copy to .env.
#
#   cp deploy/.env.example deploy/.env
#
# Compose reads deploy/.env automatically. Leave a value out and the default in
# docker-compose.yml applies, which in every case is a laptop.

# ---------------------------------------------------------------------------
# The hostname. All three must be the same origin, and it must be the one
# people actually type: it is written into every token and compared character
# for character, so changing it later invalidates everything already issued.
#
# One origin serves all three applications — the provider at the root, the
# sign-in page under /auth, the dashboard under /console.
# ---------------------------------------------------------------------------
IDEN_ENV=prod
IDEN_ISSUER=https://iden.example.org
IDEN_AUTH_UI_BASE_URL=https://iden.example.org

# Empty is correct for a single origin: the dashboard is served from the same
# origin as the provider, so its calls are not cross-origin and there is
# nothing to allow. Name an origin here only for a browser application on a
# different host that calls the provider directly.
IDEN_ALLOWED_ADMIN_ORIGINS=[]

# The network nginx proxies from, so the provider believes its X-Forwarded-For
# and attributes requests to the real caller rather than to the proxy. Must
# match the subnet in docker-compose.tunnel.yml. Never `*`.
IDEN_FORWARDED_ALLOW_IPS=172.31.250.0/24

# ---------------------------------------------------------------------------
# Branding. Shown on the sign-in page and in the dashboard.
# ---------------------------------------------------------------------------
IDEN_ORG_NAME=Example University
IDEN_ORG_LOGO_URL=

# ---------------------------------------------------------------------------
# The tunnel. Create one at Cloudflare Zero Trust > Networks > Tunnels and
# copy its token. It is a credential: it authenticates this host as the tunnel,
# so treat it the way you treat a password.
# ---------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=
